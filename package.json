{
  "name": "@anturno/branch",
  "version": "0.0.1",
  "description": "Give your AI agent the context and skills to build better products. Scans your repo, installs an idea-to-ship workflow as agent skills.",
  "license": "MIT",
  "author": "Anturno (https://github.com/anturno)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anturno/branch.git"
  },
  "homepage": "https://github.com/anturno/branch#readme",
  "bugs": {
    "url": "https://github.com/anturno/branch/issues"
  },
  "type": "module",
  "bin": {
    "branch": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "packageManager": "bun@1.4.2",
  "keywords": [
    "claude-code",
    "codex",
    "agent-skills",
    "ai",
    "context",
    "claude",
    "agents-md",
    "cli",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "typescript": "^5.9.3"
  }
}
